{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Entrenar modelo",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "subProcess": false,
            "justMyCode": true
        },
        {
            "name": "Continuar entrenamiento",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "args": ["--resume"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "subProcess": false,
            "justMyCode": true
        },
        {
            "name": "Jugar",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Jugar (escala de grises)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--gris"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Jugar (modo prueba)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--fake"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
